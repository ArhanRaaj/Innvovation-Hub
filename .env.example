# ============================================================================
# THE INNOVATION HUB - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` and fill in your custom API credentials.
# Note: Vite requires environment variables exposed to the client to start with VITE_
# ============================================================================

# Google Gemini API Key
# Used for real-time generative chat, hardware architecture synthesis, and circuit reasoning
# Get your key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Groq Cloud API Key (Optional, for ultra-low-latency Llama-3.3 70B inference)
# Get your key at: https://console.groq.com/keys
VITE_GROQ_API_KEY=

# OpenRouter API Key (Optional, multi-model fallback)
# Get your key at: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=

# Supabase Database & Realtime Configuration (Optional, for cloud sync)
